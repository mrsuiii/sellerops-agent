# Copy to .env and fill in. Never commit .env.

# --- Evaluation / tracing (LangSmith) ---
# Required only for `scripts/evaluate_agent.py --cloud`.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=sellerops-agent

# --- Optional Gemini prose judge (`--judge gemini`) ---
GEMINI_API_KEY=

