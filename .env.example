# Copy to .env and fill in. Never commit .env.

# --- Evaluation / tracing (LangSmith) ---
# Required only for `scripts/evaluate_agent.py --cloud`.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=sellerops-agent

# --- Optional Gemini prose judge (`--judge gemini`) ---
GEMINI_API_KEY=

# --- Hosted LLM provider ---
# Pick one: anthropic (Claude API) | openai_compatible (e.g. build.nvidia.com)
# SELLEROPS_LLM_PROVIDER=anthropic

# Option 1: Claude API. ANTHROPIC_API_KEY is read directly by the `anthropic` SDK.
ANTHROPIC_API_KEY=
# SELLEROPS_LLM_MODEL=claude-opus-5-5   # e.g. claude-sonnet-5-5, claude-haiku-5-5
# SELLEROPS_LLM_EFFORT=medium           # low | medium | high | xhigh | max

# Option 2: OpenAI-compatible endpoint (NVIDIA build.nvidia.com by default)
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
# LLM_MODEL=                            # model id from the provider's catalog

# --- SellerOps runtime (all optional; defaults shown) ---
# SELLEROPS_PROJECT_ROOT=.            # repo root; required for non-editable installs
# SELLEROPS_DATA_DIR=data
# SELLEROPS_WEB_DIR=web
# SELLEROPS_RESULTS_DIR=results
# SELLEROPS_CATALOG_PATH=data/store/fashion_catalog.json
# SELLEROPS_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
# SELLEROPS_LOG_FORMAT=text           # text | json
# SELLEROPS_CORS_ORIGINS=             # comma-separated, e.g. http://localhost:5173
