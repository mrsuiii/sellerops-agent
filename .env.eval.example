# Environment for the eval container only. Copy to .env.eval and fill in.
# Never commit .env.eval. Keep these keys separate from production:
# e.g. a dedicated Anthropic workspace key with its own spend limit.

# --- Agent under test + LLM user simulator (Claude API) ---
ANTHROPIC_API_KEY=
SELLEROPS_LLM_MODEL=claude-haiku-5-5
SELLEROPS_LLM_EFFORT=medium

# --- Message judge (NVIDIA, OpenAI-compatible); only needed with --judge ---
LLM_API_KEY=
SELLEROPS_JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- LangSmith: eval traces in their own project ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sellerops-eval

SELLEROPS_LOG_FORMAT=json
